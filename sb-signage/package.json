{
  "name": "sb-signage",
  "version": "2.0.0",
  "description": "Plataforma de digital signage — painel CMS + players pareados por código, sync em tempo real e cache offline.",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=2 \"test/*.test.js\"",
    "build:exe": "node scripts/vendor.js && pkg . --targets node22-win-x64 --output dist/sb-midias.exe && node scripts/copy-ffmpeg.js",
    "vendor": "node scripts/vendor.js"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/socket.io/client-dist/*"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0",
    "hls.js": "^1.5.20",
    "lucide-static": "^1.68.0",
    "sortablejs": "^1.15.7"
  }
}
